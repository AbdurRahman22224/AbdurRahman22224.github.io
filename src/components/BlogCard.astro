---
interface Props {
    title: string;
    description: string;
    pubDate: Date;
    url: string;
    tags?: string[];
}

const { title, description, pubDate, url, tags } = Astro.props;
---

<a href={url} class="block group">
    <div
        class="bg-card border border-border rounded-lg p-6 h-full transition-all duration-300 hover:shadow-lg hover:border-primary/50"
    >
        <div class="flex flex-col h-full">
            <div class="flex justify-between items-start mb-4">
                <h3
                    class="text-xl font-bold text-foreground group-hover:text-primary transition-colors line-clamp-2"
                >
                    {title}
                </h3>
                <span
                    class="text-muted-foreground text-sm whitespace-nowrap ml-4"
                >
                    {
                        pubDate.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                        })
                    }
                </span>
            </div>

            <p class="text-muted-foreground mb-6 flex-grow line-clamp-3">
                {description}
            </p>

            {
                tags && tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mt-auto">
                        {tags.map((tag) => (
                            <span class="px-2 py-1 bg-secondary text-secondary-foreground rounded text-xs">
                                {tag}
                            </span>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</a>
